# ============================================================
# Emergency Evacuation AI — Environment Variables
# ============================================================
# Copy this file to .env and adjust variables as needed.
# Defaults are pre-configured for instant demo mode execution.
# ============================================================

# --- Core Application Mode ---
# Operating mode: 'demo' uses simulated crowd & traffic; 'production' enables full sensor pipelines
APP_MODE=demo
LOG_LEVEL=INFO

# --- Backend API Server ---
# Host and port for the FastAPI application
HOST=0.0.0.0
PORT=8000
DEBUG=true

# --- Database Storage ---
# SQLite URL (default, local file in ./data/):
DATABASE_URL=sqlite:///./data/evacuation.db
# PostgreSQL (production alternative):
# DATABASE_URL=postgresql+psycopg://evac:evac_password@localhost:5432/evacuation

# --- Optional LLM Orchestration ---
# Set provider if using LLM-backed decision reasoning in coordinator agent
# Supported providers: openai | gemini | anthropic | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Inter-Agent Event Bus ---
# In-memory Python bus is used by default when USE_REDIS=false
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# --- Routing Engine Integration ---
# NetworkX Dijkstra is used natively; OSRM can be enabled if an external server is running
USE_OSRM=false
OSRM_URL=http://localhost:5000

# --- Traffic Simulation Engine ---
# Fallback Python ODE simulator is used natively; SUMO can be enabled if installed
USE_SUMO=false
SUMO_HOME=
