# ============================================================
# Emergency Evacuation AI — Environment Variables
# ============================================================
# Copy this to .env and customize as needed.
# All values have safe defaults for demo mode.
# ============================================================

# --- App Mode ---
APP_MODE=demo           # demo | production
LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true

# --- Database ---
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./data/evacuation.db
# PostgreSQL (uncomment for production):
# DATABASE_URL=postgresql+psycopg://evac:evac_password@localhost:5432/evacuation

# --- LLM (optional) ---
# Leave empty for rule-based coordinator (demo mode)
LLM_PROVIDER=openai     # openai | gemini | anthropic | ollama
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Communication ---
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# --- OSRM (optional) ---
USE_OSRM=false
OSRM_URL=http://localhost:5000
